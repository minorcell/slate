<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="@dimen/tile_radius" />
            <solid android:color="@color/tile_background" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/tile_radius" />
            <gradient
                android:centerX="0.16"
                android:centerY="0.06"
                android:endColor="#00FFFFFF"
                android:gradientRadius="220dp"
                android:startColor="@color/tile_glow"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/tile_radius" />
            <stroke
                android:width="1dp"
                android:color="@color/tile_stroke" />
        </shape>
    </item>
</layer-list>
